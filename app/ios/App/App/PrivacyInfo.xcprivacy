<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  隱私權資訊清單（Apple 自 2024-05 起強制要求，缺了上傳就會收到
  ITMS-91053 之類的警告信）。

  這一份是照 claude/privacy.html 現在寫的內容翻過來的，對照如下：

  ・02 用 Google 登入　　→　EmailAddress、Name、UserID（都 linked）
  ・03 你自己填進來的資料　→　OtherUserContent（留言、回報、問卷）、
  　　　　　　　　　　　　　　OtherDataTypes（生日、家人生日）
  ・05 位置資訊　　　　　→　**不宣告**。政策寫「只在裝置上排序，不會傳給我們」，
  　　　　　　　　　　　　　　沒有離開裝置就不算 collected
  ・08 Google Analytics　→　DeviceID（not linked）、ProductInteraction

  兩件要自己確認的事：
  1. App Store Connect 的隱私問卷要跟這份對得起來（審核是比對兩邊，不是只看這個檔）。
  2. 以後加了推播、Sign in with Apple、或把定位座標送去後端查詢，
     這份要跟著改。
-->
<plist version="1.0">
<dict>
	<!-- 沒有做跨 App／跨站的廣告追蹤，也沒有要 IDFA。
	     GA 有開啟但沒開廣告功能（privacy.html 第 8 節），所以不算 Apple 定義的 tracking。 -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<!-- Google 登入會拿到 email、顯示名稱；Supabase 會給一組使用者 ID。
		     三者都跟帳號綁在一起（linked），但只用來讓資料跨裝置同步。 -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeEmailAddress</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeName</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- 留言、使用回報、回饋問卷的文字。 -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherUserContent</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- 生日與家人的生日。Apple 的清單裡沒有「生日」這一項，歸到 Other Data。 -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherDataTypes</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- 造訪統計：隨機裝置代號 + Google Analytics 的 Cookie。
		     沒登入時跟真實身分無關，所以 not linked。 -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeDeviceID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>
		<!-- 「看了哪個分頁、點了哪一筆優惠」。登入後這些紀錄會跟帳號關聯，所以 linked。 -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeProductInteraction</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>
	<!-- 「需要說明理由的 API」。Capacitor 自己跟登入 plugin 都會用 UserDefaults
	     存自己的狀態，CA92.1 = 只存取本 App 自己的資料。 -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
